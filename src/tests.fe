// Run the tests with `fe test`.

use ingot::{Vault, VaultMsg}
use std::evm::{days, ether}

#[test(balance = 10_000_000_000_000_000_000)]
fn deposit_is_locked() uses (evm: mut Evm) {
    let vault = evm.create2<Vault>(value: Wei::zero(), args: (days(7),), salt: 0)

    let unlock: Timestamp = evm
        .call(
            addr: vault,
            gas: 200000,
            value: ether(1),
            message: VaultMsg::Deposit {},
        )
    let balance: Wei = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::BalanceOf { owner: evm.address() },
        )
    assert!(balance == ether(1))

    let stored: Timestamp = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::UnlockTime { owner: evm.address() },
        )
    assert!(stored == unlock)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn withdraw_before_unlock_reverts() uses (evm: mut Evm) {
    let vault = evm.create2<Vault>(value: Wei::zero(), args: (days(7),), salt: 0)
    let _: Timestamp = evm
        .call(
            addr: vault,
            gas: 200000,
            value: ether(1),
            message: VaultMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: vault,
            gas: 200000,
            value: Wei::zero(),
            message: VaultMsg::Withdraw { to: evm.address() },
        )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn withdraw_after_unlock() uses (evm: mut Evm) {
    // Without a lock period, a deposit can be withdrawn right away.
    let vault = evm.create2<Vault>(value: Wei::zero(), args: (Duration::zero(),), salt: 0)
    let _: Timestamp = evm
        .call(
            addr: vault,
            gas: 200000,
            value: ether(1),
            message: VaultMsg::Deposit {},
        )

    let payee = Address::new(0x1234)
    let withdrawn: Wei = evm
        .call(
            addr: vault,
            gas: 200000,
            value: Wei::zero(),
            message: VaultMsg::Withdraw { to: payee },
        )
    assert!(withdrawn == ether(1))
    assert!(evm.balance(payee) == ether(1))
    let balance: Wei = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::BalanceOf { owner: evm.address() },
        )
    assert!(balance == Wei::zero())
}
